# Generated by go2rpm 1.19.0
%bcond check 1

# https://github.com/omarroth/doubletake
%global goipath         doubletake
%global forgeurl        https://github.com/omarroth/doubletake
Version:                0.5.0

%gometa -L -f

%global common_description %{expand:
doubletake is an AirPlay screen mirroring sender for Linux. It streams the
desktop to an Apple TV or another AirPlay receiver, capturing the screen
through PipeWire and xdg-desktop-portal on Wayland or directly on X11, and
encoding it with GStreamer using NVENC, VA-API, OpenH264, x264 or x265.}

Name:           doubletake
Release:        %autorelease
Summary:        AirPlay screen mirroring sender for Linux

License:        LGPL-3.0-or-later
URL:            %{gourl}
Source0:        %{gosource}
Source1:        doubletake.service

BuildRequires:  systemd-rpm-macros

# doubletake runs gst-launch-1.0 and gst-inspect-1.0 to build its pipelines.
Requires:       gstreamer1
# videoconvert, videoscale, videorate, audioconvert, audioresample
Requires:       gstreamer1-plugins-base
# pulsesrc, ximagesrc, rtph264pay, rtph265pay
Requires:       gstreamer1-plugins-good
# h264parse and h265parse, plus the VA-API and NVENC encoders
Requires:       gstreamer1-plugins-bad-free
# pactl selects the default audio sink for capture
Requires:       pulseaudio-utils
# Wayland screen and audio capture
Recommends:     pipewire-gstreamer
Recommends:     xdg-desktop-portal
# Software H.264 encoder for systems without VA-API or NVENC
Recommends:     gstreamer1-plugin-openh264
# x264enc and x265enc are available from RPM Fusion
Suggests:       gstreamer1-plugins-ugly
Suggests:       gstreamer1-plugins-bad-freeworld

%description %{common_description}

%package        plasma-applet
Summary:        KDE Plasma system tray applet for doubletake
BuildArch:      noarch
Requires:       %{name} = %{version}-%{release}
Requires:       plasma-workspace

%description    plasma-applet
A KDE Plasma 6 system tray applet that controls a running doubletake daemon
through doubletake-ctl.

%prep
%goprep -A
%autopatch -p1

%generate_buildrequires
